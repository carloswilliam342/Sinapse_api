generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Teacher {
  id        String   @id @default(uuid())
  name      String
  email     String
  login     String   @unique
  password  String
  status    String   @default("active") // "active" | "inactive"
  subject   String
  role  String  @default("teacher")  // "master" | "teacher"
  createdAt DateTime @default(now())

  classes        Class[]
  activities     Activity[]
  passwordResets PasswordReset[]

  @@map("teachers")
}

model Class {
  id        String @id @default(uuid())
  name      String
  year      String
  shift     String // "morning" | "afternoon" | "evening"
  teacherId String

  teacher           Teacher             @relation(fields: [teacherId], references: [id])
  students          Student[]
  routines          RoutineItem[]
  routineSnapshots  RoutineSnapshot[]
  observations      LessonObservation[]

  @@map("classes")
}

model Student {
  id                 String @id @default(uuid())
  name               String
  classId            String
  registrationNumber String
  birthDate          String
  needsTea           Boolean @default(false)
  needsTdah          Boolean @default(false)
  otherNeeds         String  @default("")
  needsObservations  String  @default("")

  class              Class                @relation(fields: [classId], references: [id])
  profile            StudentProfile?
  observations       LessonObservation[]
  performanceRecords PerformanceRecord[]
  activities         Activity[]

  @@map("students")
}

model StudentProfile {
  id               String   @id @default(uuid())
  studentId        String   @unique
  neurodivergence  String[] @default([])
  difficulties     String[] @default([])
  performanceLevel String   @default("beginner") // "beginner" | "intermediate" | "advanced"
  notes            String   @default("")

  student Student @relation(fields: [studentId], references: [id])

  @@map("student_profiles")
}

model Activity {
  id              String   @id @default(uuid())
  title           String
  subject         String
  description     String
  visualResources String[] @default([])
  difficulty      Int
  adaptedFor      String[] @default([])
  studentId       String?
  teacherId       String?
  createdAt       DateTime @default(now())

  teacher            Teacher?            @relation(fields: [teacherId], references: [id])
  student            Student?            @relation(fields: [studentId], references: [id], onDelete: SetNull)
  steps              ActivityStep[]
  routines           RoutineItem[]
  observations       LessonObservation[]
  performanceRecords PerformanceRecord[]

  @@map("activities")
}

model ActivityStep {
  id          String @id @default(uuid())
  activityId  String
  order       Int
  description String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@map("activity_steps")
}

model RoutineItem {
  id           String  @id @default(uuid())
  classId      String
  dayOfWeek    Int
  time         String
  title        String
  activityId   String?
  reminder     Boolean @default(false)
  reminderText String?
  color        String

  class    Class     @relation(fields: [classId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])

  @@map("routine_items")
}

model LessonObservation {
  id            String @id @default(uuid())
  studentId     String
  classId       String
  date          String
  behavior      String // "excellent" | "good" | "regular" | "difficult"
  participation String // "high" | "medium" | "low"
  completion    String // "completed" | "completed_with_help" | "not_completed"
  notes         String @default("")
  activityId    String?

  student  Student   @relation(fields: [studentId], references: [id])
  class    Class     @relation(fields: [classId], references: [id])
  activity Activity? @relation(fields: [activityId], references: [id])

  @@map("lesson_observations")
}

model PerformanceRecord {
  id              String @id @default(uuid())
  studentId       String
  activityId      String
  activityTitle   String
  date            String
  status          String // "completed" | "completed_with_help" | "not_completed"
  difficultyLevel Int
  notes           String @default("")

  student  Student  @relation(fields: [studentId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id])

  @@map("performance_records")
}

model PasswordReset {
  id        String    @id @default(uuid())
  teacherId String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@map("password_resets")
}

model SystemLog {
  id        String   @id @default(uuid())
  userId    String
  userName  String
  action    String   // "CREATE" | "UPDATE" | "DELETE"
  entity    String   // "teacher" | "class" | "student" | "activity"
  entityId  String?
  details   String
  ip        String?
  createdAt DateTime @default(now())

  @@map("system_logs")
}

model RoutineSnapshot {
  id        String   @id @default(uuid())
  classId   String
  weekStart DateTime // Segunda-feira da semana
  weekEnd   DateTime // Domingo da semana
  items     Json     // Array de itens da rotina naquela semana
  createdAt DateTime @default(now())

  class     Class    @relation(fields: [classId], references: [id])

  @@unique([classId, weekStart])
  @@map("routine_snapshots")
}
