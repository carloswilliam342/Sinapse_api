# Obrigatórias
DATABASE_URL="postgresql://user:password@host:5432/database_name"
JWT_SECRET="uma-chave-secreta-longa-e-aleatoria"

# Opcionais
PORT=3001
FRONTEND_URL="https://your-frontend.vercel.app"
GEMINI_API_KEY="your-gemini-api-key"      # necessária para sugestões de atividade por IA
GEMINI_ALLOW_STUDENT_DATA=false         # manter false no plano gratuito; true exige Cloud Billing ativo no projeto e avaliação do tratamento dos dados
RESEND_API_KEY="your-resend-api-key"      # necessária para e-mail de redefinição de senha
GEMINI_MODEL="gemini-3.5-flash-lite"      # modelo das sugestões; não altera a etapa de material
GEMINI_MODEL_MATERIAL="gemini-3.8-flash"  # modelo do material pronto; sem troca automática em falhas ou limite de cota
MAIL_FROM="Sinapse <nao-responda@seu-dominio.com>"   # remetente; exige domínio verificado no Resend. Sem isto usa o remetente de teste, que só entrega ao dono da conta
APP_TIMEZONE="America/Sao_Paulo"          # fuso usado para decidir "que dia é hoje" (painel e semana da rotina)
TRUST_PROXY_HOPS=1                      # proxies confiáveis na frente do servidor (Render); 0 se não houver nenhum

# Só para `npm run seed` (o seed APAGA todas as tabelas)
# SEED_CONFIRM="host-do-banco"            # obrigatório quando o banco não é local: repita o host do DATABASE_URL
# SEED_PASSWORD="senha-das-contas-de-exemplo"   # se ausente, o seed gera uma e mostra no terminal
